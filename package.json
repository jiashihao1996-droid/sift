{
  "name": "sift",
  "private": true,
  "version": "1.0.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "check:rust": "cd src-tauri && cargo fmt --check && cargo clippy --all-targets -- -D warnings && cargo test",
    "test:raw-samples": "cd src-tauri && cargo test real_raw -- --ignored --nocapture",
    "gen:types": "cd src-tauri && cargo test --quiet export_bindings",
    "release": "bash scripts/release.sh"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.12.0",
    "@tauri-apps/plugin-dialog": "^2.8.0",
    "@tauri-apps/plugin-shell": "^2.4.0",
    "@vueuse/core": "^12.8.2",
    "@vueuse/motion": "^2.2.6",
    "defu": "^6.1.7",
    "lucide-vue-next": "^0.474.0",
    "pinia": "^2.3.1",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tauri-apps/cli": "^2.12.0",
    "@types/node": "^22.13.14",
    "@vitejs/plugin-vue": "^5.2.3",
    "autoprefixer": "^10.6.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "postcss": "^8.5.3",
    "prettier": "^3.9.9",
    "tailwindcss": "^3.4.17",
    "typescript": "~5.7.2",
    "typescript-eslint": "^8.71.0",
    "vite": "^6.3.0",
    "vitest": "^4.1.11",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^2.2.8"
  }
}
